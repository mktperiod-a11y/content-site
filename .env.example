# 로컬 개발용 환경변수 예시입니다. 실제 값은 .env.local에 저장하고 커밋하지 마세요.

# KOBIS(영화진흥위원회) Open API 키. https://www.kobis.or.kr 에서 발급.
# 국내 개봉작 검색 카탈로그(제목·감독·연도·출연진·등급)에 사용합니다.
KOBIS_API_KEY=

# TMDB(The Movie Database) API 키 (v3). https://www.themoviedb.org 에서 발급.
# 포스터·배경 이미지·평점·줄거리·리뷰 및 국내(KR) OTT 제공처 정보에 사용합니다.
# 주의: TMDB 데이터를 노출하는 화면에는 출처 표기가 필수입니다
#       (components/tmdb-attribution.tsx 참고).
TMDB_API_KEY=

# --- 아래는 선택 사항: 개발/테스트용 API 베이스 URL 오버라이드 ---
# 로컬 목 서버를 띄워 네트워크 없이 화면을 검증할 때만 설정하세요.
# 비워두면 실제 KOBIS/TMDB 엔드포인트를 사용합니다.
# KOBIS_API_BASE=
# TMDB_API_BASE=
# TMDB_IMAGE_BASE=
